{
  "name": "codequest",
  "version": "1.0.0",
  "private": true,
  "description": "CodeQuest - plataforma gamificada para aprendizagem de programacao",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:static": "cross-env NEXT_OUTPUT=export next build",
    "seed:gen": "tsx scripts/generate-seed.ts",
    "content:check": "tsx scripts/validar-conteudo.ts",
    "content:verify-python": "tsx scripts/dump-exercises.ts python > .exercises.json && python scripts/verificar_saidas.py .exercises.json",
    "test:amigos": "tsx scripts/testar-amigos.mts",
    "cap:sync": "npm run build:static && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:apk:unix": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:progresso": "tsx scripts/testar-progresso.mts",
    "test:migrations": "tsx scripts/testar-migrations.mts",
    "test:tags": "tsx scripts/testar-tags.mts",
    "test:pvp": "tsx scripts/testar-pvp.mts",
    "test:ranqueado": "tsx scripts/testar-ranqueado.mts",
    "og:gen": "node scripts/gerar-og.mjs",
    "test:seo": "tsx scripts/testar-seo.mts",
    "content:verify-js": "tsx scripts/dump-exercises.ts javascript > .exercises-js.json && node scripts/verificar-saidas-js.mjs .exercises-js.json",
    "test:desafios": "tsx scripts/testar-desafios.mts",
    "test:estrutura": "tsx scripts/testar-estrutura.mts"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.4",
    "@capacitor/core": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@supabase/supabase-js": "^2.48.1",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-deep-link": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@electric-sql/pglite": "^0.5.7",
    "@tauri-apps/cli": "^2.2.7",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
