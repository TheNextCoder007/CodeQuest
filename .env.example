# ---------------------------------------------------------------------------
# CodeQuest - variaveis de ambiente
# Copie este arquivo para `.env.local` e preencha com as suas chaves.
# Nenhuma dessas chaves e secreta a ponto de nao poder ir para o navegador:
# a `anon key` do Supabase e publica por design (a seguranca vem do RLS).
# ---------------------------------------------------------------------------

# Supabase -> Project Settings > Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo

# URL publica do site. Usada em DOIS lugares:
#   1. redirect do Google OAuth no navegador;
#   2. sitemap.xml, robots.txt e as tags Open Graph (previa do link).
# Em desenvolvimento: http://localhost:3000
# Em producao: https://seu-projeto.vercel.app
#
# Na Vercel, se voce esquecer de configurar, o projeto usa sozinho o dominio
# fixo de producao (VERCEL_PROJECT_PRODUCTION_URL) - entao o sitemap nunca sai
# apontando para localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deep link usado pelos apps empacotados (.apk / .exe) para voltar do Google.
# Precisa bater com o schema registrado no Capacitor e no Tauri.
NEXT_PUBLIC_DEEP_LINK_SCHEME=codequest
